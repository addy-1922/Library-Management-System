# Environment
DJANGO_SECRET_KEY=your-super-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite by default - uncomment for production)
# DJANGO_DB_ENGINE=django.db.backends.postgresql
# DJANGO_DB_NAME=library_db
# DJANGO_DB_USER=library_user
# DJANGO_DB_PASSWORD=your_password
# DJANGO_DB_HOST=localhost
# DJANGO_DB_PORT=5432

# Library Rules
LIBRARY_MAX_BORROW_LIMIT=5
LIBRARY_BORROW_PERIOD_DAYS=14
LIBRARY_FINE_INITIAL_RATE=5
LIBRARY_FINE_LATE_RATE=10
LIBRARY_FINE_FREE_DAYS=7
